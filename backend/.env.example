# =====================================================
# 채우다 백엔드 환경변수 (운영 배포 시 모두 필수)
# =====================================================
# 운영 시 이 파일을 복사해서 .env 로 만들지 말고,
# EC2/배포 환경의 시스템 환경변수 또는 AWS Secrets Manager / Parameter Store에 등록할 것.

# ── Spring profile ───────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Server ───────────────────────────────────────────
SERVER_PORT=8080

# ── Database (MySQL) ─────────────────────────────────
DB_URL=jdbc:mysql://your-rds-endpoint:3306/chaeuda?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=chaeuda
DB_PASSWORD=<STRONG_PASSWORD>

# ── Admin 계정 시드 (첫 실행 시 자동 생성, 이후 미사용) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>
ADMIN_EMAIL=ops@example.com

# ── 인증 토큰 서명 시크릿 (32바이트 이상 무작위 문자열) ──
# 생성 예: openssl rand -base64 48
APP_AUTH_SECRET=<RANDOM_AT_LEAST_32_BYTES>

# ── 인증 쿠키 ────────────────────────────────────────
AUTH_COOKIE_SECURE=true        # HTTPS 환경에서 true
AUTH_COOKIE_SAME_SITE=Lax      # 또는 Strict

# ── CORS ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# ── 이미지 저장소 ────────────────────────────────────
STORAGE_TYPE=s3                # local | s3
S3_BUCKET=chaeuda-uploads
S3_REGION=ap-northeast-2
S3_PUBLIC_URL_BASE=             # 비워두면 https://{bucket}.s3.{region}.amazonaws.com
S3_ENDPOINT_OVERRIDE=           # LocalStack 등 테스트용, 운영에서는 비워둠

# (로컬 백업) STORAGE_TYPE=local 일 때만 사용
UPLOAD_DIR=./uploads

# ── AWS 자격증명 ─────────────────────────────────────
# EC2에서는 IAM Role을 권장 (이 변수들 불필요)
# 로컬에서 S3 테스트 시에만:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

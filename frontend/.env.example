# =====================================================
# 채우다 프런트엔드 환경변수
# =====================================================
# 로컬 개발: .env.local 로 복사 (이미 .gitignore에 등록됨)
# 운영: 빌드 시 주입하거나 호스팅 플랫폼에 등록

# 백엔드 API base URL
# - 로컬:  http://localhost:8080
# - 운영:  https://api.your-domain.example.com  또는 동일 도메인 사용 시 빈 문자열도 가능
NEXT_PUBLIC_API_BASE=http://localhost:8080
